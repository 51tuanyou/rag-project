# Copy to .env before `docker compose up`

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://10.10.10.125,http://10.10.10.125:8000,http://llm.paoditu.com,http://llm.paoditu.com:8000
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://10.10.10.125,http://10.10.10.125:80,http://llm.paoditu.com

# ---- Postgres / PGVector (postgres-ctr) ----
USE_POSTGRES=True
POSTGRES_DB=rag_vectors
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag123
POSTGRES_HOST=postgres-ctr
POSTGRES_PORT=5432
PGVECTOR_HOST=postgres-ctr
PGVECTOR_PORT=5432
PGVECTOR_DB=rag_vectors
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=rag123

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt,md
DEFAULT_TOP_K=3
DEFAULT_SIMILARITY_THRESHOLD=0.7

OPENAI_API_BASE=https://api.openai.com/v1
OLLAMA_API_BASE=http://host.docker.internal:11434

BACKEND_PORT=8000
FRONTEND_PORT=80
# same-origin = browser calls /api on the same host; nginx proxies to backend
VITE_API_BASE=same-origin
