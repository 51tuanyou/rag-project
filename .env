# Copy to .env before `docker compose up`
# Existing Postgres + PGVector are used — no database container is started.

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- Existing Postgres (Django app DB) ----
# Postgres runs in container postgres-ctr (separate compose). Use its container name.
USE_POSTGRES=True
POSTGRES_DB=rag_vectors
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag123
POSTGRES_HOST=postgres-ctr
POSTGRES_PORT=5432

# ---- Existing PGVector DB (same postgres-ctr) ----
PGVECTOR_HOST=postgres-ctr
PGVECTOR_PORT=5432
PGVECTOR_DB=rag_vectors
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=rag123

# ---- CORS / frontend access ----
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ---- Optional Langfuse ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- Upload / retrieval ----
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt,md
DEFAULT_TOP_K=3
DEFAULT_SIMILARITY_THRESHOLD=0.7

# ---- LLM defaults ----
OPENAI_API_BASE=https://api.openai.com/v1
# Host-machine Ollama from containers:
OLLAMA_API_BASE=http://host.docker.internal:11434

# ---- Compose publish ports / frontend build ----
BACKEND_PORT=8000
FRONTEND_PORT=80
# Browser-side API base (must be reachable from your machine, not a Docker service name)
VITE_API_BASE=http://localhost:8000
